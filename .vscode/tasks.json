{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset=Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/software/NIWatch"
			},
			"group": "build",
			"problemMatcher": [],
			"detail": "Configure CMake project using presets"
		},
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/Debug",
				"--config",
				"Debug",
				"--target",
				"all"
			],
			"options": {
				"cwd": "${workspaceFolder}/software/NIWatch"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": ["configure"],
			"problemMatcher": ["$gcc"],
			"detail": "Build NIWatch project"
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/Debug",
				"--target",
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}/software/NIWatch"
			},
			"group": "build",
			"problemMatcher": [],
			"detail": "Clean build artifacts"
		},
		{
			"label": "rebuild",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/Debug",
				"--config",
				"Debug",
				"--clean-first",
				"--target",
				"all"
			],
			"options": {
				"cwd": "${workspaceFolder}/software/NIWatch"
			},
			"dependsOn": ["configure"],
			"group": "build",
			"problemMatcher": ["$gcc"],
			"detail": "Clean and rebuild the project"
		},
		{
			"label": "install",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--install",
				"build/Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/software/NIWatch"
			},
			"group": "build",
			"problemMatcher": [],
			"detail": "Install build artifacts"
		}
	]
}
